# Cognito User Pool configuration (public values may be used by browser)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-1_REPLACE_ME
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=REPLACE_ME
NEXT_PUBLIC_COGNITO_HOSTED_UI_DOMAIN=your-domain.auth.ap-southeast-1.amazoncognito.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side auth verification
COGNITO_USER_POOL_ID=ap-southeast-1_REPLACE_ME
COGNITO_APP_CLIENT_ID=REPLACE_ME
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=ApiPortalConfigurations

# Elastic EDOT — use the exact OTLP endpoint shown by your Elastic deployment
OTEL_SERVICE_NAME=api-developer-portal
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment.name=dev
OTEL_EXPORTER_OTLP_ENDPOINT=https://REPLACE_WITH_ELASTIC_OTLP_ENDPOINT
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey REPLACE_WITH_BASE64_ENCODED_API_KEY
