{
  "family": "api-developer-portal",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/apiDeveloperPortalTaskRole",
  "containerDefinitions": [
    {
      "name": "api-developer-portal",
      "image": "<ACCOUNT_ID>.dkr.ecr.ap-southeast-1.amazonaws.com/api-developer-portal:0.1.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-southeast-1"
        },
        {
          "name": "DYNAMODB_TABLE",
          "value": "ApiPortalConfigurations"
        },
        {
          "name": "COGNITO_USER_POOL_ID",
          "value": "ap-southeast-1_REPLACE_ME"
        },
        {
          "name": "COGNITO_APP_CLIENT_ID",
          "value": "REPLACE_ME"
        },
        {
          "name": "NEXT_PUBLIC_COGNITO_USER_POOL_ID",
          "value": "ap-southeast-1_REPLACE_ME"
        },
        {
          "name": "NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID",
          "value": "REPLACE_ME"
        },
        {
          "name": "NEXT_PUBLIC_COGNITO_HOSTED_UI_DOMAIN",
          "value": "your-domain.auth.ap-southeast-1.amazoncognito.com"
        },
        {
          "name": "NEXT_PUBLIC_APP_URL",
          "value": "https://portal.example.com"
        },
        {
          "name": "OTEL_SERVICE_NAME",
          "value": "api-developer-portal"
        },
        {
          "name": "OTEL_RESOURCE_ATTRIBUTES",
          "value": "service.version=0.1.0,deployment.environment.name=dev"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
          "value": "https://REPLACE_WITH_ELASTIC_OTLP_ENDPOINT"
        }
      ],
      "secrets": [
        {
          "name": "OTEL_EXPORTER_OTLP_HEADERS",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:<ACCOUNT_ID>:secret:elastic-otlp-headers-REPLACE"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/api-developer-portal",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "app"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q -O - http://127.0.0.1:3000/ >/dev/null 2>&1 || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}