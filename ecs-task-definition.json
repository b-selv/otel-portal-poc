{
  "family": "api-developer-portal",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::601625517010:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::601625517010:role/apiPortalServerlessTaskRole",
  "containerDefinitions": [
    {
      "name": "api-developer-portal",
      "image": "601625517010.dkr.ecr.ap-southeast-1.amazonaws.com/api-developer-portal:0.1.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "AWS_REGION", "value": "ap-southeast-1" },
        { "name": "DYNAMODB_TABLE", "value": "ApiPortalConfigurationElkServerless" },
        { "name": "COGNITO_USER_POOL_ID", "value": "ap-southeast-1_LcvBpNRCQ" },
        { "name": "COGNITO_APP_CLIENT_ID", "value": "31oj252bber2pt56ooftblhrvg" },
        { "name": "NEXT_PUBLIC_COGNITO_USER_POOL_ID", "value": "ap-southeast-1_LcvBpNRCQ" },
        { "name": "NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID", "value": "31oj252bber2pt56ooftblhrvg" },
        { "name": "NEXT_PUBLIC_COGNITO_HOSTED_UI_DOMAIN", "value": "ap-southeast-1lcvbpnrcq.auth.ap-southeast-1.amazoncognito.com" },
        { "name": "NEXT_PUBLIC_APP_URL", "value": "http://api-portal-elkserverless-789096192.ap-southeast-1.elb.amazonaws.com" },
        { "name": "OTEL_SERVICE_NAME", "value": "api-developer-portal" },
        { "name": "OTEL_RESOURCE_ATTRIBUTES", "value": "service.version=0.1.0,deployment.environment.name=dev" },
        { "name": "OTEL_EXPORTER_OTLP_ENDPOINT", "value": "https://apexstackops0-obs-bb0aed.apm.ap-southeast-1.aws.elastic.cloud:443" },
        { "name": "OTEL_EXPORTER_OTLP_HEADERS", "value": "Authorization=ApiKey eDluSmk2RUJReDVQblYzRHQxRlU6ZFhIazNSeEZKUU9TWWRnU2pZU2p5Zw==" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" },
        { "name": "OTEL_METRICS_EXPORTER", "value": "otlp" },
        { "name": "ELASTIC_APM_TRANSACTION_IGNORE_URLS", "value": "/" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/api-portal-serverless",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "app"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3000/', (r) => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))\""],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
